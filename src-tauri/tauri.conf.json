{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rosi Reader",
  "version": "0.1.0",
  "identifier": "com.rosi.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rosi Reader",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Documento PDF", "description": "Documento PDF", "role": "Viewer" },
      { "ext": ["epub"], "name": "Livro EPUB", "description": "Livro EPUB", "role": "Viewer" },
      { "ext": ["mobi", "azw3"], "name": "Livro Kindle", "description": "Livro Kindle (MOBI/AZW3)", "role": "Viewer" },
      { "ext": ["fb2"], "name": "Livro FB2", "description": "Livro FictionBook", "role": "Viewer" },
      { "ext": ["cbz"], "name": "Quadrinhos CBZ", "description": "Quadrinhos CBZ", "role": "Viewer" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
